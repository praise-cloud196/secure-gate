# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/securegate?schema=public"

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# NextAuth URL (must match your app URL)
NEXTAUTH_URL="http://localhost:3000"

# Resend API key for transactional emails
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Resend sender email address
# Free tier: onboarding@resend.dev (only delivers to delivered@resend.dev)
# Production: "noreply@yourdomain.com" (requires verified domain in Resend)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Application URL (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis for rate limiting (optional — falls back to in-memory)
# UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"
